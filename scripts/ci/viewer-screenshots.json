    {"plugin": "andon", "shot": "plugins/andon/assets/board-viewer-screenshot.jpg",
     "build": ["python3", "plugins/andon/scripts/build_board_html.py", ".", "plugins/andon/scripts/fixtures/sample_ledger",
               "--template", "plugins/andon/assets/board-viewer.html", "--d3", "plugins/andon/assets/inline-d3.html",
               "--tokens", "plugins/andon/assets/tokens.css", "--out", "{tmp}/board.html"],
     "html": "{tmp}/board.html"},
    {"plugin": "arbeitsplan", "shot": "plugins/arbeitsplan/assets/design-viewer-screenshot.jpg",
     "build": ["python3", "plugins/arbeitsplan/scripts/build_design_html.py", "--bundle", "plugins/arbeitsplan/scripts/fixtures/design-demo.json", "--out", "{tmp}/design.html"],
     "html": "{tmp}/design.html"},
