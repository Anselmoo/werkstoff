               "--template", "plugins/befund/assets/stage-map-viewer.html", "--d3", "plugins/befund/assets/inline-d3.html",
               "--tokens", "plugins/befund/assets/tokens.css", "--out", "{tmp}/STAGE_MAP.html"],
