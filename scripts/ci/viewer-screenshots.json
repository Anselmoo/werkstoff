     "build": ["python3", "plugins/arbeitsplan/scripts/build_run_html.py", "--report", "plugins/arbeitsplan/scripts/fixtures/run-demo.json", "--out", "{tmp}/run.html"],
     "html": "{tmp}/run.html"},
    {"plugin": "befund", "shot": "plugins/befund/assets/stage-map-viewer-screenshot.jpg",
