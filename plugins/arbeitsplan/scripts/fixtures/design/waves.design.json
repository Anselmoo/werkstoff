{
  "schemaVersion": "design/1",
  "name": "rebuild-cli",
  "runId": "ap-2026-09-27-wv01",
  "problemRef": "analysis/arbeitsplan/ap-2026-09-27-wv01/problem.md",
  "offLimits": ["secrets/**", ".github/workflows/**"],
  "nodes": [
    {
      "id": "preflight",
      "kind": "script",
      "role": "runner",
      "goal": "Refuse to run from a linked worktree and record the primary checkout's HEAD as the wave-1 base",
      "depends_on": [],
      "where": "primary",
      "model": "haiku",
      "inputs": [],
      "writeScope": [],
      "script": {
        "runtime": "python",
        "command": "python3 .claude/workflows/rebuild-cli_state.py preflight",
        "expectExit": [0]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["linkedWorktree", "head"],
        "properties": {
          "linkedWorktree": {"type": "boolean"},
          "head": {"type": "string"}
        }
      }
    },
    {
      "id": "w1-parser",
      "kind": "agent",
      "role": "builder",
      "wave": 1,
      "goal": "Move argument parsing into src/cli/parser.py behind the existing public entry point",
      "depends_on": ["preflight"],
      "where": "worktree",
      "model": "opus",
      "effort": "high",
      "agentType": "rebuild-cli-builder",
      "skills": [],
      "tools": ["Read", "Edit", "Write", "Bash"],
      "inputs": ["preflight", "analysis/arbeitsplan/ap-2026-09-27-wv01/problem.md"],
      "writeScope": ["src/cli/parser.py", "tests/test_parser.py"],
      "acceptance": ["python3 -m pytest -q tests/test_parser.py"],
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["branch", "baseSha", "notes"],
        "properties": {
          "branch": {"type": "string"},
          "baseSha": {"type": "string"},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    {
      "id": "w1-render",
      "kind": "agent",
      "role": "builder",
      "wave": 1,
      "goal": "Move output rendering into src/cli/render.py",
      "depends_on": ["preflight"],
      "where": "worktree",
      "model": "opus",
      "agentType": "rebuild-cli-builder",
      "inputs": ["preflight"],
      "writeScope": ["src/cli/render.py", "tests/test_render.py"],
      "acceptance": ["python3 -m pytest -q tests/test_render.py"],
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["branch", "baseSha", "notes"],
        "properties": {
          "branch": {"type": "string"},
          "baseSha": {"type": "string"},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    {
      "id": "gate-1",
      "kind": "merge-gate",
      "role": "merger",
      "wave": 1,
      "goal": "Merge wave 1 into the integration branch and run the gates in the primary checkout",
      "depends_on": ["w1-parser", "w1-render"],
      "where": "primary",
      "model": "haiku",
      "inputs": ["w1-parser", "w1-render"],
      "writeScope": [],
      "script": {
        "runtime": "python",
        "command": "python3 .claude/workflows/rebuild-cli_state.py merge --wave {wave} --branches {branches}",
        "expectExit": [0, 1]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["green", "integrationSha", "findings"],
        "properties": {
          "green": {"type": "boolean"},
          "integrationSha": {"type": "string"},
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["gate", "source", "message"],
              "properties": {
                "gate": {"type": "string"},
                "source": {"type": "string", "enum": ["tracked", "primary-only"]},
                "message": {"type": "string"}
              }
            }
          }
        }
      }
    },
    {
      "id": "w2-dispatch",
      "kind": "agent",
      "role": "builder",
      "wave": 2,
      "goal": "Reduce src/cli/__main__.py to a dispatcher over the wave-1 modules",
      "depends_on": ["gate-1"],
      "where": "worktree",
      "model": "opus",
      "agentType": "rebuild-cli-builder",
      "inputs": ["gate-1", "w1-parser", "w1-render"],
      "writeScope": ["src/cli/__main__.py", "tests/test_main.py"],
      "acceptance": ["python3 -m pytest -q tests/test_main.py"],
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["branch", "baseSha", "notes"],
        "properties": {
          "branch": {"type": "string"},
          "baseSha": {"type": "string"},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    {
      "id": "gate-2",
      "kind": "merge-gate",
      "role": "merger",
      "wave": 2,
      "goal": "Merge wave 2 and gate it; fast-forward main only when green",
      "depends_on": ["w2-dispatch"],
      "where": "primary",
      "model": "haiku",
      "inputs": ["w2-dispatch"],
      "writeScope": [],
      "script": {
        "runtime": "python",
        "command": "python3 .claude/workflows/rebuild-cli_state.py merge --wave {wave} --branches {branches}",
        "expectExit": [0, 1]
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["green", "integrationSha", "findings"],
        "properties": {
          "green": {"type": "boolean"},
          "integrationSha": {"type": "string"},
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["gate", "source", "message"],
              "properties": {
                "gate": {"type": "string"},
                "source": {"type": "string", "enum": ["tracked", "primary-only"]},
                "message": {"type": "string"}
              }
            }
          }
        }
      }
    },
    {
      "id": "smoke",
      "kind": "agent",
      "role": "smoke",
      "goal": "Install the integrated package into a scratch directory outside the repository and run its entry point",
      "depends_on": ["gate-2"],
      "where": "scratch",
      "model": "sonnet",
      "agentType": "rebuild-cli-smoke",
      "inputs": ["gate-2"],
      "writeScope": [],
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["passed", "scratchDir", "commands"],
        "properties": {
          "passed": {"type": "boolean"},
          "scratchDir": {"type": "string"},
          "commands": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    {
      "id": "review",
      "kind": "agent",
      "role": "reviewer",
      "goal": "Review the integration branch diff against main for correctness",
      "depends_on": ["smoke"],
      "where": "primary",
      "model": "sonnet",
      "agentType": "rebuild-cli-reviewer",
      "inputs": ["gate-2", "smoke"],
      "writeScope": [],
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blocking", "findings"],
        "properties": {
          "blocking": {"type": "boolean"},
          "findings": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    {
      "id": "fix",
      "kind": "agent",
      "role": "fixer",
      "goal": "One fix round for blocking review findings, on the integration branch",
      "depends_on": ["review"],
      "when": {"node": "review", "field": "blocking", "equals": true},
      "where": "worktree",
      "model": "sonnet",
      "agentType": "rebuild-cli-fixer",
      "inputs": ["review"],
      "writeScope": ["src/cli/**", "tests/**"],
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["branch", "baseSha", "notes"],
        "properties": {
          "branch": {"type": "string"},
          "baseSha": {"type": "string"},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  ]
}
